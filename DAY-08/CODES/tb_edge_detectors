module tb_edge_detectors();

    reg clk;
    reg rst_n;
    reg a;
    wire ckt1, ckt2, ckt3;

    // Instantiate the Unit Under Test (UUT)
    edge_detectors uut (
        .clk(clk),
        .rst_n(rst_n),
        .a(a),
        .ckt1(ckt1),
        .ckt2(ckt2),
        .ckt3(ckt3)
    );

    // Clock generator (Period = 20ns)
    always #10 clk = ~clk;

    initial begin
        // Initialize signals
        clk = 0;
        rst_n = 0;
        a = 0;
        #25;
        rst_n = 1; // Release reset
        
        // Recreating the first pulse on the board (Rising edge)
        #20;
        a = 1;     // 'ckt1' and 'ckt3' will go high for 1 clock period
        
        // Recreating the second pulse on the board (Falling edge)
        #60;
        a = 0;     // 'ckt2' and 'ckt3' will go high for 1 clock period
        
        #40;
        $finish;
    end
endmodule

