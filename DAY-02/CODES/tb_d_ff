`timescale 1ns / 1ps


module tb_d_ff;
reg clk;
reg rst;
reg d;
wire q;

d_ff dut (.clk(clk),.rst(rst),.d(d),.q(q));
initial begin
    clk = 0;
    forever #5 clk = ~clk;
end
initial begin
    rst = 1;
    d = 0;
    #10;

    rst = 0;
    d = 1;
    #10;

    d = 0;
    #10;

    d = 1;
    #10;

    rst = 1;
    #10;

    rst = 0;
    d = 0;
    #10;

    $finish;
end

initial begin
    $monitor("Time=%0t clk=%b rst=%b d=%b q=%b",
              $time, clk, rst, d, q);
end

endmodule
