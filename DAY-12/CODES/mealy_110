module mealy_110(
    input clk,
    input rst,
    input x,
    output reg y
);
parameter S0 = 2'b00,
          S1 = 2'b01,
          S2 = 2'b10,
          S3 = 2'b11;  
reg [1:0] present_state, next_state;
always @(posedge clk or posedge rst)
begin
    if (rst)
        present_state <= S0;
    else
        present_state <= next_state;
end
always @(*)
begin
    next_state = S0;
    y = 1'b0;
    case (present_state)
        S0:
        begin
            if (x == 1'b0)
            begin
                next_state = S0;
                y = 1'b0;
            end
            else
            begin
                next_state = S1;
                y = 1'b0;
            end
        end
        S1:
        begin
            if (x == 1'b0)
            begin
                next_state = S1;
                y = 1'b0;
            end
            else
            begin
                next_state = S2;
                y = 1'b0;
            end
        end
        S2:
        begin
            if (x == 1'b0)
            begin
                next_state = S1;
                y = 1'b0;
            end
            else
            begin
                next_state = S0;
                y = 1'b1;
            end
        end
        S3:
        begin
            next_state = 2'bxx;
            y = 1'bx;
        end
        default:
        begin
            next_state = S0;
            y = 1'b0;
        end
    endcase
end
endmodule

